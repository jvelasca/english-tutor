          "id": "c1-m01-u01",
          "title": "Emphasis, inversion and cleft",
          "order": 1,
          "lessons": [
            {
              "id": "c1-m01-u01-l01",
              "title": "Emphasis and inversion",
              "order": 1,
              "objectives": [
                {
                  "id": "c1-m01-u01-l01-o01",
                  "can_do": "I can use inversion for emphasis in formal contexts.",
                  "title": "Inversión para énfasis",
                  "skills": ["grammar", "speaking", "writing", "vocabulary"],
                  "subskills": ["word_order"],
                  "concepts": ["inversion", "Never have I", "Not only", "Only then"],
                  "vocabulary": ["rarely", "seldom", "hardly", "no sooner"],
                  "activities": [
                    {
                      "id": "c1-m01-u01-l01-o01-a01",
                      "type": "dialogue",
                      "instruction": "Rewrite a strong opinion using inversion for emphasis.",
                      "target": "Never have I ... / Not only ... / Only then ..."
                    }
                  ],
                  "checks": [
                    {
                      "id": "c1-m01-u01-l01-o01-c01",
                      "skill": "grammar",
                      "prompt": "Choose the correct sentence (inversion):",
                      "options": ["Never have I seen such a beautiful view.", "Never I have seen such a beautiful view.", "Never have I saw such a beautiful view."],
                      "correct_index": 0
                    },
                    {
                      "id": "c1-m01-u01-l01-o01-c02",
                      "skill": "grammar",
                      "prompt": "Choose the correct sentence (inversion):",
                      "options": ["Not only did she pass the exam, but she got top marks.", "Not only she passed the exam, but she got top marks.", "Not only did she passed the exam, but she got top marks."],
                      "correct_index": 0
                    },
                    {
                      "id": "c1-m01-u01-l01-o01-c03",
                      "skill": "grammar",
                      "prompt": "Choose the correct sentence (inversion):",
                      "options": ["Only then did I realise my mistake.", "Only then I realised my mistake.", "Only then I did realise my mistake."],
                      "correct_index": 0
                    },
                    {
                      "id": "c1-m01-u01-l01-o01-c04",
                      "skill": "vocabulary",
                      "prompt": "Which word means 'raras veces'?",
                      "options": ["rarely", "usually", "always"],
                      "correct_index": 0
                    },
                    {
                      "id": "c1-m01-u01-l01-o01-c05",
                      "skill": "vocabulary",
                      "prompt": "Which word means 'apenas'?",
                      "options": ["hardly", "easily", "clearly"],
                      "correct_index": 0
                    }
                  ]
                },
                {
                  "id": "c1-m01-u01-l01-o02",
                  "can_do": "I can use cleft sentences to focus information.",
                  "title": "Cleft sentences",
                  "skills": ["grammar", "speaking", "writing"],
                  "subskills": ["word_order"],
                  "concepts": ["It is/was ... that ...", "What ... is ..."],
                  "vocabulary": [],
                  "activities": [
                    {
                      "id": "c1-m01-u01-l01-o02-a01",
                      "type": "dialogue",
                      "instruction": "Emphasise the most important part of a sentence using a cleft structure.",
                      "target": "It was ... that ... / What ... is ..."
                    }
                  ],
                  "checks": [
                    {
                      "id": "c1-m01-u01-l01-o02-c01",
                      "skill": "grammar",
                      "prompt": "Choose the correct cleft sentence:",
                      "options": ["It was the manager who made the decision.", "It was the manager which made the decision.", "Was the manager who made the decision."],
                      "correct_index": 0
                    },
                    {
                      "id": "c1-m01-u01-l01-o02-c02",
                      "skill": "grammar",
                      "prompt": "Choose the correct cleft sentence:",
                      "options": ["What I need is more time.", "What I need it is more time.", "What I need are more time."],
                      "correct_index": 0
                    },
                    {
                      "id": "c1-m01-u01-l01-o02-c03",
                      "skill": "grammar",
                      "prompt": "Choose the correct cleft sentence:",
                      "options": ["It is confidence that matters most.", "It is confidence what matters most.", "Confidence it is that matters most."],
                      "correct_index": 0
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
