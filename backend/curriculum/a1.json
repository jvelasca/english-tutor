{
  "course_id": "english-tutor-academy",
  "level_id": "a1",
  "level": "A1",
  "title": "A1 · Beginner",
  "description": "Introduce yourself, talk about everyday life, family, home, food and plans.",
  "modules": [
    {
      "id": "a1-m01",
      "title": "Introductions",
      "order": 1,
      "units": [
        {
          "id": "a1-m01-u01",
          "title": "Personal information",
          "order": 1,
          "lessons": [
            {
              "id": "a1-m01-u01-l01",
              "title": "Introducing yourself",
              "order": 1,
              "objectives": [
                {
                  "id": "a1-m01-u01-l01-o01",
                  "can_do": "I can introduce myself and give basic personal information.",
                  "title": "Presentarme",
                  "skills": ["speaking", "vocabulary", "grammar"],
                  "concepts": ["I am", "My name is", "I live in", "I am from", "I work as"],
                  "vocabulary": ["name", "country", "city", "job", "age", "family", "hobby"],
                  "activities": [
                    {
                      "id": "a1-m01-u01-l01-o01-a01",
                      "type": "dialogue",
                      "instruction": "Introduce yourself to the tutor: your name, country, city and job.",
                      "target": "I am ... / My name is ... / I live in ..."
                    }
                  ]
                },
                {
                  "id": "a1-m01-u01-l01-o02",
                  "can_do": "I can ask someone's name and where they are from.",
                  "title": "Preguntar el nombre y origen",
                  "skills": ["speaking", "grammar", "vocabulary"],
                  "concepts": ["What is your name?", "Where are you from?", "What's"],
                  "vocabulary": ["what", "where", "your", "from", "name"],
                  "activities": [
                    {
                      "id": "a1-m01-u01-l01-o02-a01",
                      "type": "dialogue",
                      "instruction": "Ask the tutor three personal questions using What / Where.",
                      "target": "What is your name? / Where are you from?"
                    }
                  ]
                }
              ]
            },
            {
              "id": "a1-m01-u01-l02",
              "title": "Countries and numbers",
              "order": 2,
              "objectives": [
                {
                  "id": "a1-m01-u01-l02-o01",
                  "can_do": "I can say my country and nationality.",
                  "title": "Países y nacionalidades",
                  "skills": ["vocabulary", "speaking", "grammar"],
                  "concepts": ["I am from + country", "I am + nationality", "to be"],
                  "vocabulary": ["Spain", "Spanish", "Mexico", "Mexican", "France", "French", "England", "English"],
                  "activities": [
                    {
                      "id": "a1-m01-u01-l02-o01-a01",
                      "type": "fill_gap",
                      "instruction": "Complete: 'I am ___ Spain. I am ___.'",
                      "target": "I am from Spain. I am Spanish."
                    }
                  ]
                },
                {
                  "id": "a1-m01-u01-l02-o02",
                  "can_do": "I can say and understand numbers from 1 to 100.",
                  "title": "Números 1-100",
                  "skills": ["vocabulary", "listening", "speaking"],
                  "concepts": ["numbers 1-100"],
                  "vocabulary": ["one", "ten", "twenty", "fifty", "hundred"],
                  "activities": [
                    {
                      "id": "a1-m01-u01-l02-o02-a01",
                      "type": "listen",
                      "instruction": "Listen to the tutor and write down the number you hear.",
                      "target": "recognize numbers 1-100"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "a1-m02",
      "title": "Everyday Life",
      "order": 2,
      "units": [
        {
          "id": "a1-m02-u01",
          "title": "Daily routines",
          "order": 1,
          "lessons": [
            {
              "id": "a1-m02-u01-l01",
              "title": "Routines and time",
              "order": 1,
              "objectives": [
                {
                  "id": "a1-m02-u01-l01-o01",
                  "can_do": "I can describe my daily routine.",
                  "title": "Mi rutina diaria",
                  "skills": ["speaking", "grammar", "vocabulary"],
                  "concepts": ["Present Simple", "I get up", "I go to", "I have breakfast"],
                  "vocabulary": ["get up", "work", "breakfast", "lunch", "dinner", "sleep"],
                  "activities": [
                    {
                      "id": "a1-m02-u01-l01-o01-a01",
                      "type": "dialogue",
                      "instruction": "Describe a typical day to the tutor using the Present Simple.",
                      "target": "I get up at ... / I go to ... / I have breakfast at ..."
                    }
                  ]
                },
                {
                  "id": "a1-m02-u01-l01-o02",
                  "can_do": "I can tell the time and talk about days and months.",
                  "title": "La hora, días y meses",
                  "skills": ["vocabulary", "listening", "speaking"],
                  "concepts": ["What time is it?", "days of the week", "months"],
                  "vocabulary": ["Monday", "Sunday", "January", "December", "morning", "evening"],
                  "activities": [
                    {
                      "id": "a1-m02-u01-l01-o02-a01",
                      "type": "dialogue",
                      "instruction": "Say what time you do two activities and on which day.",
                      "target": "I ... at ... on Monday."
                    }
                  ]
                },
                {
                  "id": "a1-m02-u01-l01-o03",
                  "can_do": "I can talk about how often I do things.",
                  "title": "Frecuencia",
                  "skills": ["grammar", "speaking", "vocabulary"],
                  "concepts": ["always", "usually", "sometimes", "never", "every day"],
                  "vocabulary": ["always", "usually", "often", "sometimes", "never"],
                  "activities": [
                    {
                      "id": "a1-m02-u01-l01-o03-a01",
                      "type": "dialogue",
                      "instruction": "Tell the tutor how often you do three activities.",
                      "target": "I always ... / I sometimes ... / I never ..."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
