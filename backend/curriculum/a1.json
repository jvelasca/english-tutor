                  "activities": [
                    {
                      "id": "a1-m03-u01-l01-o01-a01",
                      "type": "dialogue",
                      "instruction": "Describe your family to the tutor using 'I have got'.",
                      "target": "I have got a brother. / My mother is ..."
                    }
                  ]
                },
                {
                  "id": "a1-m03-u01-l01-o02",
                  "can_do": "I can describe people's appearance and personality.",
                  "title": "Describir personas",
                  "skills": ["vocabulary", "grammar", "speaking"],
                  "concepts": ["be + adjective", "tall", "short", "friendly"],
                  "vocabulary": ["tall", "short", "young", "old", "friendly", "kind", "happy"],
                  "activities": [
                    {
                      "id": "a1-m03-u01-l01-o02-a01",
                      "type": "dialogue",
                      "instruction": "Describe a friend using three adjectives.",
                      "target": "He/She is tall and friendly."
                    }
                  ]
                }
              ]
            },
            {
              "id": "a1-m03-u01-l02",
              "title": "Possessives",
              "order": 2,
              "objectives": [
                {
                  "id": "a1-m03-u01-l02-o01",
                  "can_do": "I can talk about what belongs to people.",
                  "title": "Posesivos",
                  "skills": ["grammar", "vocabulary", "speaking"],
                  "concepts": ["my", "your", "his", "her", "their", "'s"],
                  "vocabulary": ["my", "your", "his", "her", "our", "their"],
                  "activities": [
                    {
                      "id": "a1-m03-u01-l02-o01-a01",
                      "type": "fill_gap",
                      "instruction": "Complete: 'This is Maria and ___ brother.'",
                      "target": "This is Maria and her brother."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
