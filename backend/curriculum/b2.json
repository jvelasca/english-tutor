  "level": "B2",
  "title": "B2 · Upper Intermediate",
  "description": "Argue clearly, understand complex texts and fast, connected speech with multiple speakers, and express nuanced opinions.",
  "modules": [
    {
      "id": "b2-m01",
      "title": "Argumentation & Complexity",
      "order": 1,
      "units": [
        {
          "id": "b2-m01-u01",
          "title": "Structuring arguments",
          "order": 1,
          "lessons": [
            {
              "id": "b2-m01-u01-l01",
              "title": "Discourse markers and cohesion",
              "order": 1,
              "objectives": [
                {
                  "id": "b2-m01-u01-l01-o01",
                  "can_do": "I can structure a clear argument using discourse markers.",
                  "title": "Linking ideas: contrast and concession",
                  "skills": ["writing", "speaking", "vocabulary", "grammar"],
                  "subskills": ["cohesion", "coherence", "collocations", "word_order"],
                  "scenario_ids": ["work_meeting"],
                  "concepts": ["However / Nevertheless", "Although / Even though", "On the other hand"],
                  "vocabulary": ["however", "nevertheless", "although", "whereas", "despite"],
                  "activities": [
                    {
                      "id": "b2-m01-u01-l01-o01-a01",
                      "type": "essay",
                      "instruction": "Write a short paragraph arguing for or against remote work, using at least three discourse markers.",
                      "target": "Although ... / However ... / On the other hand ..."
                    },
                    {
                      "id": "b2-m01-u01-l01-o01-a02",
                      "type": "recall",
                      "instruction": "Without looking, name three discourse markers for contrast.",
                      "target": "however / although / on the other hand",
                      "phase": "retrieve"
                    },
                    {
                      "id": "b2-m01-u01-l01-o01-a03",
                      "type": "dialogue",
                      "instruction": "Argue for or against a topic you have not discussed in this unit.",
                      "target": "Although ... / Nevertheless ... / On the other hand ...",
                      "phase": "transfer"
                    },
                    {
                      "id": "b2-m01-u01-l01-o01-a04",
                      "type": "recall",
                      "instruction": "In one sentence, say what you learned to do in this unit.",
                      "target": "I can structure a clear argument using discourse markers.",
                      "phase": "review"
                    },
                    {
                      "id": "b2-m01-u01-l01-o01-a05",
                      "type": "essay",
                      "instruction": "On your own, write a short paragraph arguing for or against remote work using three discourse markers.",
                      "target": "Although ... / However ... / On the other hand ...",
                      "phase": "assess"
                    }
                  ],
                  "checks": [
                    {
                      "id": "b2-m01-u01-l01-o01-c01",
                      "skill": "vocabulary",
                      "prompt": "Which discourse marker introduces a contrast?",
                      "options": ["However", "Moreover", "Therefore"],
                      "correct_index": 0
                    },
                    {
                      "id": "b2-m01-u01-l01-o01-c02",
                      "skill": "grammar",
                      "prompt": "Choose the correct sentence:",
                      "options": ["Although it rained, we went out.", "Although it rained, but we went out.", "Although it rained, however we went out."],
                      "correct_index": 0
                    },
                    {
                      "id": "b2-m01-u01-l01-o01-c03",
                      "skill": "vocabulary",
                      "prompt": "Which word means 'a pesar de'?",
                      "options": ["despite", "besides", "during"],
                      "correct_index": 0
                    }
                  ]
                },
                {
                  "id": "b2-m01-u01-l01-o02",
                  "can_do": "I can express cause and consequence precisely.",
                  "title": "Cause and consequence",
                  "skills": ["writing", "vocabulary", "grammar"],
                  "subskills": ["cohesion", "collocations", "prepositions"],
                  "concepts": ["due to / owing to", "as a result", "consequently"],
                  "vocabulary": ["consequently", "therefore", "owing", "result", "cause"],
                  "activities": [
                    {
                      "id": "b2-m01-u01-l01-o02-a01",
                      "type": "essay",
                      "instruction": "Explain one consequence of climate change using 'as a result' and 'owing to'.",
                      "target": "Owing to ... / As a result ..."
                    }
                  ],
                  "checks": [
                    {
                      "id": "b2-m01-u01-l01-o02-c01",
                      "skill": "vocabulary",
                      "prompt": "Which phrase means 'como resultado'?",
                      "options": ["as a result", "in spite of", "as long as"],
                      "correct_index": 0
                    },
                    {
                      "id": "b2-m01-u01-l01-o02-c02",
                      "skill": "grammar",
                      "prompt": "Choose the correct sentence:",
                      "options": ["The match was cancelled owing to the rain.", "The match was cancelled owing the rain.", "The match was cancelled owing to raining."],
                      "correct_index": 0
                    }
                  ]
                }
              ]
            },
            {
              "id": "b2-m01-u01-l02",
              "title": "Hypothesis and reported speech",
              "order": 2,
              "objectives": [
                {
                  "id": "b2-m01-u01-l02-o03",
                  "can_do": "I can talk about hypothetical situations using the second and third conditional.",
                  "title": "Second and third conditionals",
                  "skills": ["grammar", "speaking", "vocabulary"],
                  "subskills": ["conditionals", "fluency", "collocations", "interaction", "turn_taking"],
                  "scenario_ids": ["problem_solving"],
                  "concepts": ["second conditional (unreal present)", "third conditional (unreal past)", "wish / if only"],
                  "vocabulary": ["hypothetical", "regret", "imagine", "suppose", "would have"],
                  "activities": [
                    {
                      "id": "b2-m01-u01-l02-o03-a01",
                      "type": "dialogue",
                      "instruction": "Say what you would have done differently last year.",
                      "target": "If I had ... I would have ..."
                    }
                  ],
                  "checks": [
                    {
                      "id": "b2-m01-u01-l02-o03-c01",
                      "skill": "grammar",
                      "prompt": "Choose the correct sentence (unreal past):",
                      "options": ["If I had studied, I would have passed.", "If I studied, I would have passed.", "If I had studied, I would passed."],
                      "correct_index": 0
                    },
                    {
                      "id": "b2-m01-u01-l02-o03-c02",
                      "skill": "grammar",
                      "prompt": "Choose the correct sentence (unreal present):",
                      "options": ["If I had more time, I would travel more.", "If I have more time, I would travel more.", "If I had more time, I will travel more."],
                      "correct_index": 0
                    },
                    {
                      "id": "b2-m01-u01-l02-o03-c03",
                      "skill": "vocabulary",
                      "prompt": "Which word means 'hipotético'?",
                      "options": ["hypothetical", "historical", "hysterical"],
                      "correct_index": 0
                    }
                  ]
                },
                {
                  "id": "b2-m01-u01-l02-o04",
                  "can_do": "I can report what others said accurately using reported speech.",
                  "title": "Reported speech and reporting verbs",
                  "skills": ["grammar", "reading", "vocabulary"],
                  "subskills": ["reported_speech", "detail", "word_families"],
                  "concepts": ["backshift of tenses", "say / tell / ask", "reporting verbs (claim, admit, deny)"],
                  "vocabulary": ["claim", "admit", "deny", "suggest", "reported"],
                  "activities": [
                    {
                      "id": "b2-m01-u01-l02-o04-a01",
                      "type": "dialogue",
                      "instruction": "Report what a friend told you last week about their job.",
                      "target": "He told me that ... / She claimed that ..."
                    }
                  ],
                  "checks": [
                    {
                      "id": "b2-m01-u01-l02-o04-c01",
                      "skill": "grammar",
                      "prompt": "Choose the correct reported sentence for 'I am tired' (he said):",
                      "options": ["He said he was tired.", "He said he is tired.", "He said he has tired."],
                      "correct_index": 0
                    },
                    {
                      "id": "b2-m01-u01-l02-o04-c02",
                      "skill": "vocabulary",
                      "prompt": "Which reporting verb means 'decir que algo es verdad'?",
                      "options": ["claim", "deny", "ask"],
                      "correct_index": 0
                    },
                    {
                      "id": "b2-m01-u01-l02-o04-c03",
                      "skill": "reading",
                      "prompt": "Read: 'She claimed she had finished the report.' According to her, who finished it?",
                      "options": ["She did", "The report did", "Nobody did"],
                      "correct_index": 0
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
