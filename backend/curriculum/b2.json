                  "can_do": "I can understand connected speech and reduced forms in fast speech.",
                  "title": "Connected speech and reduced forms",
                  "skills": ["listening", "vocabulary"],
                  "subskills": ["connected_speech", "fast_speech", "phrase_recognition"],
                  "listening_items": ["c031", "c032", "c033", "c034"],
                  "concepts": ["gonna / wanna / gotta", "elision and assimilation", "weak forms"],
                  "vocabulary": ["gonna", "wanna", "gotta", "kinda", "dunno"],
                  "activities": [
                    {
                      "id": "b2-m02-u01-l01-o06-a01",
                      "type": "listening",
