                    },
                    {
                      "id": "b2-m02-u01-l01-o05-a04",
                      "type": "recall",
                      "instruction": "In one sentence, say what you learned to do in this unit.",
                      "target": "I can follow a conversation between several speakers at natural speed.",
                      "phase": "review"
                    },
                    {
                      "id": "b2-m02-u01-l01-o05-a05",
                      "type": "listening",
                      "instruction": "On your own, listen to a fast conversation and identify who changed the plan.",
