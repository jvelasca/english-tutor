{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend solo API (uvicorn :8000)",
      "type": "node-terminal",
      "request": "launch",
      "command": ".venv\\Scripts\\python.exe -m uvicorn main:app --host 127.0.0.1 --port 8000 --reload",
      "cwd": "${workspaceFolder}/backend"
    },
    {
      "name": "App completa HTTPS :8000 (producto)",
      "type": "node-terminal",
      "request": "launch",
      "command": ".venv\\Scripts\\python.exe -m scripts.ensure_tls_cert && .venv\\Scripts\\python.exe -m uvicorn main:app --host 127.0.0.1 --port 8000 --ssl-certfile data\\certs\\cert.pem --ssl-keyfile data\\certs\\key.pem --reload",
      "cwd": "${workspaceFolder}/backend"
    },
    {
      "name": "Frontend dev (Vite :5173)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev -- --open",
      "cwd": "${workspaceFolder}/frontend"
    }
  ],
  "compounds": [
    {
      "name": "Desarrollo con HMR (Vite :5173 + API :8000)",
      "configurations": [
        "Backend solo API (uvicorn :8000)",
        "Frontend dev (Vite :5173)"
      ],
      "stopAll": true
    }
  ]
}
